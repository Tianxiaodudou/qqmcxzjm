#!/bin/bash
#
# 安装完成后：记录向导配置，并同步把运行时依赖装好（包内 wheel 离线安装，通常几秒）
#
set -u

ETC_DIR="${TRIM_PKGETC}"
VAR_DIR="${TRIM_PKGVAR}"
LOG_FILE="${VAR_DIR}/info.log"
REQ_FILE="${TRIM_APPDEST}/requirements.txt"
# python312 运行时路径：优先从 TRIM_APPDEST（形如 <APPS_ROOT>/<app>/target）推导，避免硬编码路径
APPS_ROOT="$(cd "$(dirname "$(dirname "${TRIM_APPDEST:-}")")" 2>/dev/null && pwd)" || APPS_ROOT=""
if [ -z "${APPS_ROOT}" ] || [ ! -x "${APPS_ROOT}/python312/target/bin/python3" ]; then
    APPS_ROOT="/${QQMUSIC_APPS_VOL:-var}/apps"
    if [ -n "${TRIM_APPDEST_VOL:-}" ] && [ -x "${TRIM_APPDEST_VOL}/apps/python312/target/bin/python3" ]; then
        APPS_ROOT="${TRIM_APPDEST_VOL}/apps"
    fi
fi
PY_RUNTIME_DIR="${APPS_ROOT}/python312/target/bin"
BOOTSTRAP_PY="${PY_RUNTIME_DIR}/python3"
VENV_DIR="${VAR_DIR}/venv"

log_msg() {
    mkdir -p "${VAR_DIR}" 2>/dev/null
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

# 保存向导配置到应用配置目录（由生命周期脚本和 Web 服务读取）
save_settings() {
    mkdir -p "${ETC_DIR}" 2>/dev/null
    {
        printf 'wizard_lyric_trans=%s\n' "${wizard_lyric_trans:-true}"
        # 下载节奏（安装向导收集；空值表示使用应用内置默认）
        if [ -n "${wizard_interval_min_ms:-}" ]; then
            printf 'wizard_interval_min_ms=%s\n' "${wizard_interval_min_ms}"
        fi
        if [ -n "${wizard_interval_max_ms:-}" ]; then
            printf 'wizard_interval_max_ms=%s\n' "${wizard_interval_max_ms}"
        fi
        # v1.0.1：下载目录与文件夹授权合并，由应用内「选择文件夹」决定；旧包传入时保留
        if [ -n "${wizard_download_dir:-}" ]; then
            printf 'wizard_download_dir=%s\n' "${wizard_download_dir}"
        fi
    } > "${ETC_DIR}/settings.env"
    chmod 600 "${ETC_DIR}/settings.env" 2>/dev/null
}

# pip 安装依赖：优先用应用包内预置 wheel 离线安装，失败回退镜像/官方源
install_requirements() {
    local pip="${VENV_DIR}/bin/pip"
    local wheels="${TRIM_APPDEST}/wheels"
    local mirror="${QQMUSIC_PIP_INDEX:-https://mirrors.aliyun.com/pypi/simple/}"

    if [ -d "${wheels}" ] \
        && "${pip}" install --disable-pip-version-check --no-index --find-links "${wheels}" -r "${REQ_FILE}" >> "${LOG_FILE}" 2>&1; then
        log_msg "安装阶段：依赖安装完成（应用包内 wheel 离线安装）"
        return 0
    fi
    log_msg "安装阶段：离线安装未完成，改用镜像源安装：${mirror}"
    if "${pip}" install --disable-pip-version-check --prefer-binary -i "${mirror}" -r "${REQ_FILE}" >> "${LOG_FILE}" 2>&1; then
        log_msg "安装阶段：依赖安装完成（镜像源）"
        return 0
    fi
    log_msg "安装阶段：镜像源安装失败，回退官方源安装"
    "${pip}" install --disable-pip-version-check -r "${REQ_FILE}" >> "${LOG_FILE}" 2>&1
}

# 安装阶段就把运行环境备好（离线 wheel，通常几秒），用户点「启用」时才能秒开
prepare_runtime() {
    if [ ! -x "${BOOTSTRAP_PY}" ]; then
        log_msg "未找到 python312 运行时，跳过依赖预安装"
        return 0
    fi
    mkdir -p "${VAR_DIR}"
    if [ ! -x "${VENV_DIR}/bin/python" ]; then
        log_msg "安装阶段：创建虚拟环境"
        "${BOOTSTRAP_PY}" -m venv "${VENV_DIR}" >> "${LOG_FILE}" 2>&1 || {
            log_msg "虚拟环境创建失败，将在首次启动时重试"
            return 0
        }
    fi
    if command -v flock >/dev/null 2>&1; then
        exec 9>>"${VAR_DIR}/.pip.lock"
        flock -w 600 9 || log_msg "安装阶段：等待依赖安装锁超时"
    fi
    if install_requirements; then
        sha1sum "${REQ_FILE}" 2>/dev/null | awk '{print $1}' > "${VENV_DIR}/.requirements.sha1"
        log_msg "安装阶段：依赖预安装完成"
    else
        log_msg "安装阶段：依赖预安装失败，将在首次启动时重试"
    fi
    return 0
}

save_settings
# 同步执行：安装阶段就装好依赖，用户点「启用」时无需再等（旧的 & 后台方式会让启用与安装抢网络）
prepare_runtime
exit 0
