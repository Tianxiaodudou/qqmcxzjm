<?xml version="1.0" encoding="utf-8"?>
<!--
  服务器地址由用户自己填，通常是局域网里的 NAS（http://192.168.x.x:5666），
  域名无法预先枚举，所以对任意主机允许明文；证书仍走系统信任链，不做任何例外。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
